Description: drop -mbranch-protection=standard from node_js2c on arm64
 node.gyp enables pointer authentication for every target-toolset target when
 target_arch is arm64.  This reverts that for node_js2c, matching the Node 20
 patch set, whose anchor was the `libraries!` line that 202-node_gyp.patch
 inserts into the same target.
--- a/node.gyp
+++ b/node.gyp
@@ -1612,7 +1612,8 @@
       'target_name': 'node_js2c',
       'type': 'executable',
       'toolsets': ['host'],
       'libraries!':[ '-licui18n', '-licuuc', '-licudata', '-lcrypto', '-lssl', '-lz', '-lhttp_parser', '-luv', '-lnghttp2', '-lcares' ],
+      'cflags!': ['-mbranch-protection=standard'],
       'include_dirs': [
         'tools',
         'src',
