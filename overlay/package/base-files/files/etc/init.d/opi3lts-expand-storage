#!/bin/sh /etc/rc.common
# Grow the root partition to the end of the card and expand its filesystem.
# For a squashfs image, OpenWrt stores rootfs_data after the squashfs bytes in
# the same partition and exposes it through a loop device.  For an ext4 image,
# the root filesystem is the partition itself.  Both layouts are produced by
# the Orange Pi 3 LTS image targets.

START=99
USE_PROCD=0

. /lib/functions.sh

MARKER=/etc/opi3lts-storage-expanded

block_sectors() {
	local device="$1"
	device=${device#/dev/}
	cat "/sys/class/block/$device/size" 2>/dev/null || printf '0\n'
}

block_start() {
	local device="$1"
	device=${device#/dev/}
	cat "/sys/class/block/$device/start" 2>/dev/null || printf '0\n'
}

root_partition() {
	local path candidate uuid part_number candidate_number

	# OpenWrt's mount_root resolves /dev/root to the actual partition. This is
	# available on the target image and avoids requiring blkid or udev's
	# /dev/disk/by-partuuid hierarchy.
	path=$(readlink -f /dev/root 2>/dev/null || true)
	case "$path" in
		/dev/*)
			if [ -b "$path" ] && [ -s "/sys/class/block/${path##*/}/partition" ]; then
				printf '%s\n' "$path"
				return 0
			fi
			;;
	esac

	# Fallback for systems without /dev/root.  The low byte of an MBR
	# PARTUUID is the partition number; use it to find the actual partition
	# instead of assuming that rootfs is partition 2.
	uuid=$(sed -n 's/.*root=PARTUUID=[^ -]*-\([0-9A-Fa-f][0-9A-Fa-f]\).*/\1/p' /proc/cmdline)
	part_number=$(printf '%s\n' "$uuid" | sed 's/^0*//')
	[ -n "$part_number" ] || return 1
	for candidate in /dev/mmcblk*p* /dev/sd*[0-9] /dev/nvme*n1p*; do
		[ -b "$candidate" ] || continue
		candidate_number=$(cat "/sys/class/block/${candidate##*/}/partition" 2>/dev/null || true)
		[ "$candidate_number" = "$part_number" ] || continue
		printf '%s\n' "$candidate"
		return 0
	done
	return 1
}

partition_table_sectors() {
	local disk="$1" partition="$2"
	sfdisk -d "$disk" 2>/dev/null | awk -v wanted="$partition" '
		$1 == wanted {
			for (i = 1; i <= NF; i++) {
				if ($i == "size=") {
					value = $(i + 1)
					gsub(/,/, "", value)
					print value
					exit
				}
				if ($i ~ /^size=/) {
					sub(/^size=/, "", $i)
					gsub(/,/, "", $i)
					print $i
					exit
				}
			}
		}
	}'
}

start() {
	local rootpart disk root_type overlaydev overlay_type tool board resize_tool
	local root_name root_sys disk_name part_number part_sectors disk_sectors
	local part_start target_sectors new_part_sectors table_sectors

	[ -e "$MARKER" ] && return 0
	board=$(board_name 2>/dev/null || true)
	[ "$board" = "xunlong,orangepi-3-lts" ] || {
		logger -t opi3lts-expand-storage "unsupported board: $board"
		return 0
	}
	for tool in sfdisk partx; do
		command -v "$tool" >/dev/null 2>&1 || {
			logger -t opi3lts-expand-storage "$tool is unavailable; will retry"
			return 0
		}
	done

	rootpart=$(root_partition) || {
		logger -t opi3lts-expand-storage 'root partition not found; will retry'
		return 0
	}
	root_name=${rootpart##*/}
	root_sys="/sys/class/block/$root_name"
	[ -e "$root_sys" ] || {
		logger -t opi3lts-expand-storage "sysfs entry not found for $rootpart"
		return 0
	}
	disk_name=$(basename "$(dirname "$(readlink -f "$root_sys" 2>/dev/null || true)")")
	disk="/dev/$disk_name"
	part_number=$(cat "$root_sys/partition" 2>/dev/null || true)
	[ -n "$disk_name" ] || {
		logger -t opi3lts-expand-storage "cannot determine parent disk for $rootpart"
		return 0
	}
	case "$part_number" in
		''|*[!0-9]*|0)
			logger -t opi3lts-expand-storage "cannot determine disk or partition number for $rootpart"
			return 0
			;;
	esac
	[ -b "$disk" ] || {
		logger -t opi3lts-expand-storage "parent block device not found for $rootpart"
		return 0
	}

	# Do not resize the filesystem based only on sfdisk's exit status.  With a
	# mounted root partition the kernel can keep the old in-memory table while
	# sfdisk has already written the new table to the card.  Growing loop0 in
	# that state creates an ext4 filesystem larger than its partition and makes
	# the next boot fail with "bad geometry".
	part_sectors=$(block_sectors "$rootpart")
	disk_sectors=$(block_sectors "$disk")
	part_start=$(block_start "$rootpart")
	case "$part_sectors:$disk_sectors:$part_start" in
		''|*[!0-9:]*|0:*|*:0*|*:*:0)
			logger -t opi3lts-expand-storage "cannot read block geometry for $rootpart on $disk"
			return 0
			;;
	esac
	target_sectors=$((disk_sectors - part_start))
	if [ "$target_sectors" -le 0 ]; then
		logger -t opi3lts-expand-storage "invalid target partition size on $disk"
		return 0
	fi

	if [ "$part_sectors" -lt "$target_sectors" ]; then
		# A blank start with '+' size preserves the current partition start and consumes
		# all free sectors after it. --no-reread avoids failing while /rom is open.
		if ! printf ',+\n' | sfdisk --no-reread -N "$part_number" "$disk" >/tmp/opi3lts-sfdisk.log 2>&1; then
			logger -t opi3lts-expand-storage "partition resize failed: $(cat /tmp/opi3lts-sfdisk.log)"
			return 0
		fi
		sync
		table_sectors=$(partition_table_sectors "$disk" "$rootpart")
		case "$table_sectors" in
			''|*[!0-9]*)
				logger -t opi3lts-expand-storage "cannot verify the on-disk partition table for $rootpart"
				return 0
				;;
		esac
		if [ "$table_sectors" -lt "$target_sectors" ]; then
			logger -t opi3lts-expand-storage "on-disk partition table did not reach the end of $disk"
			return 0
		fi
		partx -u "$disk" >/dev/null 2>&1 || true
		sleep 1
		new_part_sectors=$(block_sectors "$rootpart")
		if [ "$new_part_sectors" -lt "$target_sectors" ]; then
			# /etc may still be the read-only SquashFS during preinit, so no
			# persistent marker can be relied on here. Reboot only after sfdisk's
			# on-disk table was verified above; next boot reads it afresh.
			sync
			logger -t opi3lts-expand-storage "partition table written but kernel still has old size; rebooting before mount_root"
			(sleep 1; reboot) >/dev/null 2>&1 &
			return 0
		fi
	fi

	# In preinit there is no mounted /rom or / yet. The partition phase above is
	# still safe there; mount_root will then create the loop-backed rootfs_data
	# against the new partition size. The S99 invocation later performs the
	# filesystem resize after the overlay is mounted.
	root_type=$(awk '$2 == "/rom" { print $3; exit }' /proc/mounts)
	[ -n "$root_type" ] || root_type=$(awk '$2 == "/" { print $3; exit }' /proc/mounts)
	[ -n "$root_type" ] || return 0
	case "$root_type" in
		ext4|squashfs) : ;;
		*)
		logger -t opi3lts-expand-storage "unsupported root filesystem on $rootpart; will retry"
		return 0
		;;
	esac

	if [ "$root_type" = squashfs ]; then
		command -v losetup >/dev/null 2>&1 || {
			logger -t opi3lts-expand-storage 'losetup is unavailable; will retry'
			return 0
		}
		overlaydev=$(awk '$2 == "/overlay" { print $1; exit }' /proc/mounts)
		[ -n "$overlaydev" ] || {
			logger -t opi3lts-expand-storage 'squashfs overlay device not found; will retry after reboot'
			return 0
		}
		overlay_type=$(awk '$2 == "/overlay" { print $3; exit }' /proc/mounts)
		case "$overlay_type" in
			ext4) resize_tool=resize2fs ;;
			f2fs)
				if command -v resize.f2fs >/dev/null 2>&1; then
					resize_tool=resize.f2fs
				elif command -v resize_f2fs >/dev/null 2>&1; then
					resize_tool=resize_f2fs
				else
					logger -t opi3lts-expand-storage 'f2fs overlay detected but no f2fs resize tool is installed'
					return 0
				fi
				;;
			*)
			logger -t opi3lts-expand-storage "unsupported overlay filesystem $overlay_type on $overlaydev; will retry"
			return 0
			;;
		esac

		# The loop device was created before the partition grew. Refresh its size
		# and perform an online ext4 expansion.  The partition-size check above
		# guarantees that the backing partition is already large enough.
		losetup -c "$overlaydev" >/dev/null 2>&1 || true
		if "$resize_tool" "$overlaydev" >/tmp/opi3lts-resizefs.log 2>&1; then
			touch "$MARKER"
			logger -t opi3lts-expand-storage "expanded $overlaydev using all space on $disk"
		else
			logger -t opi3lts-expand-storage "filesystem resize deferred: $(cat /tmp/opi3lts-resizefs.log)"
		fi
		return 0
	fi

	# The ext4 image has no separate rootfs_data loop device.  resize2fs can
	# grow the mounted root filesystem online after the partition table grows.
	if resize2fs "$rootpart" >/tmp/opi3lts-resize2fs.log 2>&1; then
		touch "$MARKER"
		logger -t opi3lts-expand-storage "expanded $rootpart using all space on $disk"
	else
		logger -t opi3lts-expand-storage "filesystem resize deferred: $(cat /tmp/opi3lts-resize2fs.log)"
	fi
}
