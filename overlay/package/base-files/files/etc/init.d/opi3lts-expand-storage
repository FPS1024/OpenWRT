#!/bin/sh /etc/rc.common
# Grow the root partition to the end of the card and expand its filesystem.
# For a squashfs image, OpenWrt stores rootfs_data after the squashfs bytes in
# the same partition and exposes it through a loop device.  For an ext4 image,
# the root filesystem is the partition itself.  Both layouts are produced by
# the Orange Pi 3 LTS image targets.
#
# Never set USE_PROCD here.  /etc/rc.common enables procd with [ -n "$USE_PROCD" ],
# so even USE_PROCD=0 makes it source /lib/functions/procd.sh and replace the
# start() below with a procd wrapper that only calls start_service().  With
# USE_PROCD=0 this file became a no-op: the expansion never ran in preinit or
# from /etc/rc.d/S99.

START=99

. /lib/functions.sh

MARKER=/etc/opi3lts-storage-expanded

block_sectors() {
	local device="$1"
	device=${device#/dev/}
	cat "/sys/class/block/$device/size" 2>/dev/null || printf '0\n'
}

block_start() {
	local device="$1"
	device=${device#/dev/}
	cat "/sys/class/block/$device/start" 2>/dev/null || printf '0\n'
}

# Device number ("major:minor") of the filesystem mounted at $1, empty when that
# mount point is not backed by a block device.
mountinfo_device() {
	awk -v wanted="$1" '$5 == wanted { print $3; exit }' /proc/self/mountinfo 2>/dev/null
}

# Resolve the root partition from the device number of the read-only root
# filesystem: /rom once mount_root has pivoted the overlay, / during preinit.
# /sys/dev/block/MAJ:MIN names the partition without needing a matching node in
# /dev: procd replaces /dev with a fresh tmpfs and only creates nodes for the
# devices it found in sysfs, so the kernel's own /dev/root is gone by the time
# preinit runs.
sysfs_root_partition() {
	local mountpoint device major minor resolved

	for mountpoint in /rom /; do
		device=$(mountinfo_device "$mountpoint")
		[ -n "$device" ] || continue
		major=${device%%:*}
		minor=${device##*:}
		case "$major:$minor" in
			*[!0-9:]*|:*) continue ;;
		esac
		resolved=$(readlink -f "/sys/dev/block/$major:$minor" 2>/dev/null)
		[ -n "$resolved" ] || continue
		# Only a partition carries this attribute; a whole disk does not.
		[ -e "$resolved/partition" ] || continue
		printf '/dev/%s\n' "${resolved##*/}"
		return 0
	done

	return 1
}

root_partition() {
	local uuid part_number candidate candidate_number

	sysfs_root_partition && return 0

	# Fallback for a root= that names a PARTUUID.  The low byte of an MBR
	# PARTUUID is the partition number; scan the candidates instead of assuming
	# that the rootfs is partition 2 of the first mmc device.
	uuid=$(sed -n 's/.*root=PARTUUID=[^ -]*-\([0-9A-Fa-f][0-9A-Fa-f]\).*/\1/p' /proc/cmdline)
	part_number=$(printf '%s\n' "$uuid" | sed 's/^0*//')
	[ -n "$part_number" ] || return 1
	for candidate in /dev/mmcblk*p* /dev/sd*[0-9] /dev/nvme*n1p*; do
		[ -b "$candidate" ] || continue
		candidate_number=$(cat "/sys/class/block/${candidate##*/}/partition" 2>/dev/null || true)
		[ "$candidate_number" = "$part_number" ] || continue
		printf '%s\n' "$candidate"
		return 0
	done

	return 1
}

partition_table_sectors() {
	local disk="$1" partition="$2"
	sfdisk -d "$disk" 2>/dev/null | awk -v wanted="$partition" '
		$1 == wanted {
			for (i = 1; i <= NF; i++) {
				if ($i == "size=") {
					value = $(i + 1)
					gsub(/,/, "", value)
					print value
					exit
				}
				if ($i ~ /^size=/) {
					sub(/^size=/, "", $i)
					gsub(/,/, "", $i)
					print $i
					exit
				}
			}
		}'
}

# True when $1 already reaches the end of the card, allowing for 1 MiB of
# alignment slack against the size $2 computed from the block geometry.
partition_spans_card() {
	local size
	size=$(block_sectors "$1")
	[ -n "$size" ] && [ "$size" -ge "$(( $2 - 2048 ))" ]
}

start() {
	local rootpart disk root_type overlaydev overlay_type resize_tool
	local root_name root_sys disk_name part_number part_sectors disk_sectors
	local part_start target_sectors new_part_sectors disk_table_after

	[ -e "$MARKER" ] && return 0
	for tool in sfdisk partx; do
		command -v "$tool" >/dev/null 2>&1 || {
			logger -t opi3lts-expand-storage "$tool is unavailable; will retry"
			return 0
		}
	done

	rootpart=$(root_partition) || {
		logger -t opi3lts-expand-storage 'root partition not found; will retry'
		return 0
	}
	root_name=${rootpart##*/}
	root_sys="/sys/class/block/$root_name"
	[ -e "$root_sys" ] || {
		logger -t opi3lts-expand-storage "sysfs entry not found for $rootpart"
		return 0
	}
	disk_name=$(basename "$(dirname "$(readlink -f "$root_sys" 2>/dev/null || true)")")
	disk="/dev/$disk_name"
	part_number=$(cat "$root_sys/partition" 2>/dev/null || true)
	case "$disk_name" in
		''|*[!0-9a-zA-Z]*)
			logger -t opi3lts-expand-storage "cannot determine parent disk for $rootpart"
			return 0
			;;
	esac
	[ "$part_number" -gt 0 ] 2>/dev/null || {
		logger -t opi3lts-expand-storage "cannot determine partition number for $rootpart"
		return 0
	}
	[ -b "$disk" ] || {
		logger -t opi3lts-expand-storage "parent block device $disk not found for $rootpart"
		return 0
	}

	# Do not resize the filesystem based only on sfdisk's exit status.  With a
	# mounted root partition the kernel can keep the old in-memory table while
	# sfdisk has already written the new table to the card.  Growing the overlay
	# in that state creates a filesystem larger than its partition and makes the
	# next boot fail with "bad geometry".
	part_sectors=$(block_sectors "$rootpart")
	disk_sectors=$(block_sectors "$disk")
	part_start=$(block_start "$rootpart")
	case "$part_sectors:$disk_sectors:$part_start" in
		''|*[!0-9:]*|0:*|*:0*|*:*:0)
			logger -t opi3lts-expand-storage "cannot read block geometry for $rootpart on $disk"
			return 0
			;;
	esac
	target_sectors=$((disk_sectors - part_start))
	if [ "$target_sectors" -le 0 ]; then
		logger -t opi3lts-expand-storage "invalid target partition size on $disk"
		return 0
	fi

	if [ "$part_sectors" -lt "$target_sectors" ]; then
		# A blank start with '+' size preserves the current partition start and
		# consumes all free sectors after it. --no-reread avoids inspecting the
		# in-use device; the kernel table is refreshed below instead.
		if ! printf ',+\n' | sfdisk --no-reread -N "$part_number" "$disk" >/tmp/opi3lts-sfdisk.log 2>&1; then
			logger -t opi3lts-expand-storage "partition resize failed: $(cat /tmp/opi3lts-sfdisk.log 2>/dev/null)"
			return 0
		fi
		sync
		disk_table_after=$(partition_table_sectors "$disk" "$rootpart")
		case "$disk_table_after" in
			''|*[!0-9]*)
				logger -t opi3lts-expand-storage "cannot verify the on-disk partition table for $rootpart"
				return 0
				;;
		esac
		if [ "$disk_table_after" -lt "$target_sectors" ]; then
			logger -t opi3lts-expand-storage "on-disk partition table did not reach the end of $disk"
			return 0
		fi
		partx -u "$disk" >/dev/null 2>&1 || true
		sleep 1
		new_part_sectors=$(block_sectors "$rootpart")
		if [ "$new_part_sectors" -lt "$target_sectors" ]; then
			# The partition is mounted, so the kernel cannot re-read the table
			# now.  The on-disk table was verified above and the kernel always
			# reads the partition table when it resolves root=PARTUUID, so a
			# reboot leaves a boot with the grown partition and no loop.
			sync
			logger -t opi3lts-expand-storage "partition table written but kernel still reports $new_part_sectors of $target_sectors sectors; rebooting before mount_root"
			(sleep 1; reboot) >/dev/null 2>&1 &
			return 0
		fi
		logger -t opi3lts-expand-storage "kernel accepted the grown partition on $disk ($new_part_sectors sectors)"
	fi

	# In preinit there is no mounted /rom or / yet: the partition phase above is
	# still safe there, and mount_root then creates the loop-backed rootfs_data
	# against the new partition size.  The S99 invocation performs the
	# filesystem resize after the overlay is mounted.
	root_type=$(awk '$2 == "/rom" { print $3; exit }' /proc/mounts)
	[ -n "$root_type" ] || root_type=$(awk '$2 == "/" { print $3; exit }' /proc/mounts)
	case "$root_type" in
		ext4|squashfs) : ;;
		*)
			logger -t opi3lts-expand-storage "root filesystem ${root_type:-unknown} not mounted yet; will retry"
			return 0
			;;
	esac

	if [ "$root_type" = squashfs ]; then
		command -v losetup >/dev/null 2>&1 || {
			logger -t opi3lts-expand-storage 'losetup is unavailable; will retry'
			return 0
		}
		overlaydev=$(awk '$2 == "/overlay" { print $1; exit }' /proc/mounts)
		[ -n "$overlaydev" ] || {
			logger -t opi3lts-expand-storage 'squashfs overlay is not mounted yet; will retry'
			return 0
		}
		overlay_type=$(awk '$2 == "/overlay" { print $3; exit }' /proc/mounts)
		case "$overlay_type" in
			ext4) resize_tool=resize2fs ;;
			f2fs)
				if command -v resize.f2fs >/dev/null 2>&1; then
					resize_tool=resize.f2fs
				elif command -v resize_f2fs >/dev/null 2>&1; then
					resize_tool=resize_f2fs
				else
					logger -t opi3lts-expand-storage 'f2fs overlay detected but no f2fs resize tool is installed'
					return 0
				fi
				;;
			*)
				logger -t opi3lts-expand-storage "unsupported overlay filesystem ${overlay_type:-unknown} on $overlaydev; will retry"
				return 0
				;;
		esac

		# The loop device was created before the partition grew.  Refresh its
		# size and perform an online expansion.
		losetup -c "$overlaydev" >/dev/null 2>&1 || true
		if ! "$resize_tool" "$overlaydev" >/tmp/opi3lts-resizefs.log 2>&1; then
			logger -t opi3lts-expand-storage "filesystem resize deferred: $(cat /tmp/opi3lts-resizefs.log 2>/dev/null)"
			return 0
		fi
		if ! partition_spans_card "$rootpart" "$target_sectors"; then
			# resize2fs also succeeds when there is nothing to grow.  Recording
			# success here would disable this script forever on a card that was
			# never expanded, which is what the previous marker logic did.
			logger -t opi3lts-expand-storage "filesystem on $overlaydev is not backed by the full card yet; will retry"
			return 0
		fi
		touch "$MARKER"
		logger -t opi3lts-expand-storage "expanded $overlaydev using all space on $disk"
		return 0
	fi

	# The ext4 image has no separate rootfs_data loop device.  resize2fs can
	# grow the mounted root filesystem online after the partition table grows.
	if ! resize2fs "$rootpart" >/tmp/opi3lts-resize2fs.log 2>&1; then
		logger -t opi3lts-expand-storage "filesystem resize deferred: $(cat /tmp/opi3lts-resize2fs.log 2>/dev/null)"
		return 0
	fi
	if ! partition_spans_card "$rootpart" "$target_sectors"; then
		logger -t opi3lts-expand-storage "$rootpart does not span the card yet; will retry"
		return 0
	fi
	touch "$MARKER"
	logger -t opi3lts-expand-storage "expanded $rootpart using all space on $disk"
}
