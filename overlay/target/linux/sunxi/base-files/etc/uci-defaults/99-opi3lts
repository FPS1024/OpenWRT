#!/bin/sh
#
# Orange Pi 3 LTS (Allwinner H6) — default network topology for a
# Wi-Fi AP router:
#
#   eth0    -> WAN  (DHCP client; plug into your existing router/modem)
#   br-lan  -> LAN  (192.168.8.1, DHCP server)
#   radio0  -> AP on LAN
#
# This runs before the delayed UWE5622 driver load. Wireless configuration is
# seeded here so the generic ieee80211 hotplug detector cannot create an
# OpenWrt/unencrypted radio config before sprdwl-start runs.

. /lib/functions.sh

[ "$(board_name)" = "xunlong,orangepi-3-lts" ] || exit 0

# ---------------- network ----------------
uci -q batch <<-EOF
	delete network.@device[0]
	delete network.wan
	delete network.wan6
	set network.wan=interface
	set network.wan.device='eth0'
	set network.wan.proto='dhcp'
	set network.lan=interface
	set network.lan.device='br-lan'
	set network.lan.proto='static'
	set network.lan.ipaddr='192.168.8.1'
	set network.lan.netmask='255.255.255.0'
	set network.lan.ip6assign='60'
	add network device
	set network.@device[-1].name='br-lan'
	set network.@device[-1].type='bridge'
	commit network
EOF

# The generic odhcpd defaults run before this board-specific script and may
# disable DHCPv4 because the LAN has not yet been configured as static. Enable
# the DHCP server explicitly for the Wi-Fi LAN.
uci -q batch <<-EOF
	set dhcp.lan=dhcp
	set dhcp.lan.interface='lan'
	set dhcp.lan.start='100'
	set dhcp.lan.limit='150'
	set dhcp.lan.leasetime='12h'
	set dhcp.lan.dhcpv4='server'
	commit dhcp
EOF

# Seed the factory AP before the SDIO driver appears. The ieee80211 hotplug
# handler runs `wifi config` as soon as phy0 is registered; if it wins the
# race, it creates a generic OpenWrt SSID and the driver helper cannot tell
# that this is a fresh install from a user-configured AP.
uci -q batch <<-EOF
	set wireless.radio0=wifi-device
	set wireless.radio0.type='mac80211'
	set wireless.radio0.path='platform/unisoc_wifi'
	set wireless.radio0.band='2g'
	set wireless.radio0.channel='6'
	set wireless.radio0.htmode='HT20'
	set wireless.radio0.country='CN'
	set wireless.radio0.disabled='0'
	set wireless.default_radio0=wifi-iface
	set wireless.default_radio0.device='radio0'
	set wireless.default_radio0.network='lan'
	set wireless.default_radio0.mode='ap'
	set wireless.default_radio0.ssid='OrangePi-3-LTS'
	set wireless.default_radio0.encryption='psk2'
	set wireless.default_radio0.key='orangepi@7'
	commit wireless
EOF

# Start LuCI in Simplified Chinese. The installed language packages remain
# selectable later from System -> System -> Language and Style.
if [ -f /etc/config/luci ]; then
	uci -q set luci.main.lang='zh_cn'
	uci -q commit luci
fi

exit 0
